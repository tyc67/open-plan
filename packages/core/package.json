{
  "name": "open-plan-core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free plan model: schema, validation, migration, geometry and commands. Used by the web app and the agent tools.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  }
}
